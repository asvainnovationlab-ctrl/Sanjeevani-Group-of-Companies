// Sanjeevani Group of Companies — PostgreSQL schema (Prisma).
//
// Conventions
// - UUID primary keys (gen_random_uuid) and createdAt/updatedAt on every table.
// - Publishable content carries `status` + `publishedAt` and created/updated/
//   approved/published-by user references for the review workflow.
// - Company-scoped records keep a `companyId` so authorization can filter by
//   the user's memberships on the server.
// - Relational data is modelled as tables; Json is used only for genuinely
//   flexible content (rich-text blocks, settings values, audit metadata).
// - `legacyMongoId` keeps the old MongoDB _id for traceable migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection for migrations
}

// ---------------------------------------------------------------- enums

enum PublishStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum CompanyCategory {
  HEALTHCARE
  EDUCATION
  AGRICULTURE
  OTHER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum LeaderTier {
  BOARD
  TEAM
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  VOLUNTEER
}

enum SalaryPeriod {
  HOUR
  DAY
  MONTH
  YEAR
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  S3
  DATABASE
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum DocumentKind {
  CV
  SUPPORTING_DOCUMENT
  LEADER_DOCUMENT
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum NewsType {
  PRESS_RELEASE
  NEWS
  ANNOUNCEMENT
}

enum VideoProvider {
  YOUTUBE
  FILE
}

enum VideoPlacement {
  NEWSROOM_YOUTUBE
  GALLERY
}

enum LegalDocumentKind {
  PRIVACY_POLICY
  TERMS_OF_USE
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------- organisation

model Group {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  tagline     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companies   Company[]
}

// The six directory groupings shown on the Businesses page and in the nav.
model Sector {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String      @unique
  name      String
  detail    String?
  imageId   String?     @db.Uuid
  image     MediaAsset? @relation("SectorImage", fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  companies Company[]
}

model Company {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyMongoId   String?         @unique
  groupId         String          @db.Uuid
  group           Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sectorId        String?         @db.Uuid
  sector          Sector?         @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  name            String          @unique
  slug            String          @unique
  category        CompanyCategory
  sectorLabel     String // e.g. "Healthcare · Education" as shown on cards
  description     String
  website         String?
  email           String?
  phone           String?
  establishedYear Int?
  logoId          String?         @db.Uuid
  logo            MediaAsset?     @relation("CompanyLogo", fields: [logoId], references: [id], onDelete: SetNull)
  bannerId        String?         @db.Uuid
  banner          MediaAsset?     @relation("CompanyBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  featured        Boolean         @default(false)
  sortOrder       Int             @default(0)
  status          PublishStatus   @default(DRAFT)
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String?         @db.Uuid
  updatedById     String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  locations         Location[]
  departments       Department[]
  memberships       Membership[]
  leaderAssignments LeaderAssignment[]
  careerAreas       CareerAreaCompany[]
  vacancies         Vacancy[]
  applications      JobApplication[]
  newsArticles      NewsArticle[]
  events            Event[]
  notices           Notice[]
  galleries         Gallery[]
  contactMessages   ContactMessage[]

  @@index([status, sortOrder])
  @@index([sectorId])
}

model Location {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String // e.g. "Main campus"
  addressLine  String?
  municipality String?
  district     String?
  province     String?
  country      String    @default("Nepal")
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  phone        String?
  email        String?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vacancies    Vacancy[]

  @@index([companyId])
}

model Department {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vacancies Vacancy[]

  @@unique([companyId, slug])
}

// ---------------------------------------------------------------- users & access

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique // stored lower-cased by the service layer
  name              String
  passwordHash      String?
  status            UserStatus @default(INVITED)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String? // encrypted at rest by the service layer
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  ownedVacancies      Vacancy[]                  @relation("VacancyOwner")
  statusChanges       ApplicationStatusHistory[]
  applicationNotes    ApplicationNote[]
  auditLogs           AuditLog[]
  uploadedMedia       MediaAsset[]
  assignedMessages    ContactMessage[]           @relation("ContactAssignee")
  newsArticles        NewsArticle[]              @relation("NewsAuthor")
}

// Server-managed sessions: only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique // SUPER_ADMIN, GROUP_ADMIN, COMPANY_ADMIN, HR_MANAGER, CONTENT_EDITOR, CONTENT_PUBLISHER, AUDITOR
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberships Membership[]
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique // e.g. "vacancy.publish", "application.read"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// A user's role, either group-wide (companyId null) or for one company.
// Uniqueness for the group-wide case is enforced by a partial index in the
// migration (Postgres treats NULLs as distinct in a plain unique index).
model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId, companyId])
  @@index([companyId])
}

// ---------------------------------------------------------------- media & documents

model MediaAsset {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     StorageProvider
  storageKey   String          @unique // Cloudinary public_id, S3 key, or public/ path
  url          String
  kind         MediaKind
  mimeType     String
  bytes        Int?
  width        Int?
  height       Int?
  altText      String?
  uploadedById String?         @db.Uuid
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sectorImages     Sector[]        @relation("SectorImage")
  companyLogos     Company[]       @relation("CompanyLogo")
  companyBanners   Company[]       @relation("CompanyBanner")
  leaderPhotos     Leader[]
  careerAreaImages CareerArea[]
  newsCovers       NewsArticle[]
  eventCovers      Event[]
  galleryItems     GalleryItem[]
  videoThumbnails  Video[]         @relation("VideoThumbnail")
  videoFiles       Video[]         @relation("VideoFile")
  homepageSlides   HomepageSlide[]
  keySectors       KeySector[]
  impactPillars    ImpactPillar[]
  noticeFiles      Notice[]
}

// Private files (CVs etc.). Never served publicly: downloads go through an
// authorized route that issues a short-lived link or streams the bytes.
model PrivateDocument {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          DocumentKind
  provider      StorageProvider
  storageKey    String          @unique
  data          Bytes? // only for provider DATABASE (legacy / fallback)
  originalName  String
  mimeType      String
  bytes         Int
  sha256        String
  scanStatus    ScanStatus      @default(PENDING)
  applicationId String?         @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  leaderId      String?         @db.Uuid
  leader        Leader?         @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
  @@index([leaderId])
}

// ---------------------------------------------------------------- leadership

model Leader {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String        @unique
  name             String
  photoId          String?       @db.Uuid
  photo            MediaAsset?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  summary          String?
  biography        String?
  message          String[] // paragraphs
  responsibilities String[]
  linkedinUrl      String?
  facebookUrl      String?
  instagramUrl     String?
  xUrl             String?
  isChairman       Boolean       @default(false)
  status           PublishStatus @default(DRAFT)
  publishedAt      DateTime?
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid
  approvedById     String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assignments LeaderAssignment[]
  career      LeaderCareerEntry[]
  education   LeaderEducation[]
  documents   PrivateDocument[]
}

// A leader's designation on the group page (companyId null) or for a company
// (e.g. managing director).
model LeaderAssignment {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderId           String     @db.Uuid
  leader             Leader     @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  companyId          String?    @db.Uuid
  company            Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  tier               LeaderTier @default(TEAM)
  isManagingDirector Boolean    @default(false)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([companyId])
  @@index([leaderId])
}

model LeaderCareerEntry {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderId     String @db.Uuid
  leader       Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  period       String
  position     String
  organisation String
  sortOrder    Int    @default(0)

  @@index([leaderId])
}

model LeaderEducation {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderId      String @db.Uuid
  leader        Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  qualification String
  institution   String
  sortOrder     Int    @default(0)

  @@index([leaderId])
}

// ---------------------------------------------------------------- recruitment

model CareerArea {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String              @unique
  title        String
  type         String // e.g. "Healthcare", "Infrastructure"
  imageId      String?             @db.Uuid
  image        MediaAsset?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  companies    CareerAreaCompany[]
  vacancies    Vacancy[]
  applications JobApplication[]
}

model CareerAreaCompany {
  careerAreaId String     @db.Uuid
  careerArea   CareerArea @relation(fields: [careerAreaId], references: [id], onDelete: Cascade)
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([careerAreaId, companyId])
}

model Vacancy {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String           @unique // used in /careers/<area>/<slug>
  referenceCode      String           @unique
  companyId          String           @db.Uuid
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  careerAreaId       String?          @db.Uuid
  careerArea         CareerArea?      @relation(fields: [careerAreaId], references: [id], onDelete: SetNull)
  departmentId       String?          @db.Uuid
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId         String?          @db.Uuid
  location           Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationText       String // shown on the site, e.g. "Pokhara, Nepal"
  title              String
  summary            String
  description        String?
  responsibilities   String[]
  qualifications     String[]
  requiredEducation  String
  requiredExperience String
  skills             String[]
  requiredDocuments  String[]
  employmentType     EmploymentType   @default(FULL_TIME)
  openings           Int              @default(1)
  minAge             Int?
  maxAge             Int?
  salaryMin          Decimal?         @db.Decimal(12, 2)
  salaryMax          Decimal?         @db.Decimal(12, 2)
  salaryCurrency     String           @default("NPR")
  salaryPeriod       SalaryPeriod     @default(MONTH)
  salaryDisclosed    Boolean          @default(false)
  salaryNote         String?
  openingDate        DateTime?
  deadline           DateTime?
  status             VacancyStatus    @default(DRAFT)
  publishAt          DateTime?
  closeAt            DateTime?
  publishedAt        DateTime?
  closedAt           DateTime?
  ownerId            String?          @db.Uuid
  owner              User?            @relation("VacancyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById        String?          @db.Uuid
  updatedById        String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]

  @@index([companyId, status])
  @@index([careerAreaId, status])
  @@index([status, deadline])
}

model JobApplication {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyMongoId   String?           @unique
  referenceNumber String            @unique // e.g. SG-2026-000123
  companyId       String?           @db.Uuid // scope for authorization; null only for a general application without a company
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyId       String?           @db.Uuid
  vacancy         Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  careerAreaId    String?           @db.Uuid
  careerArea      CareerArea?       @relation(fields: [careerAreaId], references: [id], onDelete: SetNull)
  vacancyTitle    String // snapshot at submission time
  fullName        String
  email           String
  phone           String
  age             Int
  gender          String?
  address         String
  education       String
  experienceYears Decimal           @db.Decimal(4, 1)
  currentEmployer String?
  expectedSalary  String?
  coverLetter     String?
  status          ApplicationStatus @default(SUBMITTED)
  consentAt       DateTime
  dedupeKey       String? // hash(email + vacancy) used to catch repeat submissions
  submittedIpHash String?
  retainUntil     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  documents     PrivateDocument[]
  statusHistory ApplicationStatusHistory[]
  notes         ApplicationNote[]

  @@index([companyId, status, createdAt])
  @@index([vacancyId])
  @@index([email])
  @@index([dedupeKey, createdAt])
}

model ApplicationStatusHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String             @db.Uuid
  application   JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  changedById   String?            @db.Uuid
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

model ApplicationNote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String         @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String?        @db.Uuid
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body          String
  createdAt     DateTime       @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------- newsroom

model NewsCategory {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String        @unique
  name      String
  createdAt DateTime      @default(now())
  articles  NewsArticle[]
}

model NewsArticle {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String        @unique
  type           NewsType      @default(NEWS)
  title          String
  excerpt        String?
  body           Json? // block content, sanitized on render
  coverImageId   String?       @db.Uuid
  coverImage     MediaAsset?   @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  companyId      String?       @db.Uuid
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  categoryId     String?       @db.Uuid
  category       NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           String[]
  authorId       String?       @db.Uuid
  author         User?         @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishAt      DateTime?
  publishedAt    DateTime?
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  approvedById   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([companyId])
}

model Event {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String        @unique
  title        String
  summary      String?
  body         Json?
  venue        String?
  startsAt     DateTime
  endsAt       DateTime?
  coverImageId String?       @db.Uuid
  coverImage   MediaAsset?   @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  companyId    String?       @db.Uuid
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdById  String?       @db.Uuid
  updatedById  String?       @db.Uuid
  approvedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, startsAt])
}

model Notice {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  body         String?
  noticeDate   DateTime
  companyId    String?       @db.Uuid
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  attachmentId String?       @db.Uuid
  attachment   MediaAsset?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdById  String?       @db.Uuid
  updatedById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, noticeDate])
}

model Video {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  provider    VideoProvider
  url         String? // YouTube URL
  fileId      String?        @db.Uuid
  file        MediaAsset?    @relation("VideoFile", fields: [fileId], references: [id], onDelete: SetNull)
  thumbnailId String?        @db.Uuid
  thumbnail   MediaAsset?    @relation("VideoThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  placement   VideoPlacement
  sortOrder   Int            @default(0)
  status      PublishStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([placement, status, sortOrder])
}

model Gallery {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  title       String
  companyId   String?       @db.Uuid
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       GalleryItem[]
}

model GalleryItem {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  galleryId String     @db.Uuid
  gallery   Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  mediaId   String     @db.Uuid
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  caption   String
  altText   String
  sortOrder Int        @default(0)

  @@index([galleryId, sortOrder])
}

// ---------------------------------------------------------------- homepage & pages

model HomepageSlide {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label       String
  theme       String
  imageId     String?       @db.Uuid
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  href        String?
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model KeySector {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  detail      String
  href        String
  iconKey     String // maps to an icon in the frontend component
  imageId     String?       @db.Uuid
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ImpactPillar {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tab         String
  title       String
  imageId     String?       @db.Uuid
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageAlt    String
  paragraphs  String[]
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question    String
  answer      String
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

// Static pages (About Us, Our Story, Mission, Community …) keyed by route.
model StaticPage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String        @unique // e.g. "about-us", "mission-vision-values"
  title          String
  intro          String?
  body           Json?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  approvedById   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Legal documents keep every version; the public page shows the latest
// PUBLISHED version.
model LegalDocument {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      LegalDocumentKind      @unique
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  versions  LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String        @db.Uuid
  document     LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  title        String
  intro        String
  lead         String
  clauses      Json // [{ title, body }]
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdById  String?       @db.Uuid
  approvedById String?       @db.Uuid
  createdAt    DateTime      @default(now())

  @@unique([documentId, version])
  @@index([documentId, status])
}

// Generic revision snapshots for publishable content (who changed what, when).
model ContentRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  snapshot    Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ---------------------------------------------------------------- contact, settings, audit, email

model ContactMessage {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String
  phone        String?
  subject      String?
  message      String
  companyId    String?              @db.Uuid
  company      Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status       ContactMessageStatus @default(NEW)
  assignedToId String?              @db.Uuid
  assignedTo   User?                @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  ipHash       String?
  handledAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
}

model SiteSetting {
  key         String   @id // e.g. "contact.email", "social.facebook", "seo.default"
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "auth.login", "vacancy.publish", "application.status_change"
  entityType String?
  entityId   String?
  companyId  String?  @db.Uuid
  metadata   Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

// Fixed-window rate limiting shared by every server instance (login,
// password reset, applications, contact form). `key` is e.g.
// "login:ip:<hash>" or "login:email:<hash>"; old windows are pruned.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// Transactional outbox: rows are written in the same transaction as the event
// (e.g. an application) and delivered by a worker, so a provider outage never
// loses the underlying record and retries cannot double-send.
model EmailOutbox {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey    String      @unique
  template          String
  toAddress         String
  subject           String
  payload           Json
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?
  providerMessageId String?
  nextAttemptAt     DateTime    @default(now())
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------- website traffic
// Cookie-free visit counting for the admin dashboard. Days are Nepal calendar
// dates. A visitor is a keyed hash of (day, IP, browser) that changes every
// day, so nobody can be followed across days and no personal data is stored.

model SiteTrafficDay {
  day      DateTime @id @db.Date
  views    Int      @default(0)
  visitors Int      @default(0)
}

// Only needed to count each visitor once per day; pruned after two days.
model SiteVisitorDay {
  day         DateTime @db.Date
  visitorHash String

  @@id([day, visitorHash])
}

model SitePageDay {
  day   DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([day, path])
  @@index([day])
}
