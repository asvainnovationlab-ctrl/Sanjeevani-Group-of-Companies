# Copy to .env.local and fill in. Never commit real values.

# --- PostgreSQL (Neon) — new application database --------------------------
# Neon dashboard → Connection details. Use the POOLED string for DATABASE_URL
# and the DIRECT (non-pooled) string for DIRECT_URL (used by migrations).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/sanjeevani?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/sanjeevani?sslmode=require

# --- MongoDB — current database, still used until the switch-over -----------
MONGODB_URI=mongodb+srv://YOUR_ATLAS_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=Sanjeevani_group_of_companies

# --- Current shared admin login (replaced by individual accounts in Phase 3) --
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# --- Coming in later phases (leave blank until then) ------------------------
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# RESEND_API_KEY=
# EMAIL_FROM="Sanjeevani Group <no-reply@your-verified-domain>"
# HR_NOTIFICATION_EMAIL=
