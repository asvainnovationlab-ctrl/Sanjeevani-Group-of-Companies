# Copy to .env.local and fill in. Never commit real values.

# --- PostgreSQL (Neon) — new application database --------------------------
# `neon deploy` / `neon env pull` writes these. DATABASE_URL is the POOLED
# string (app traffic); DATABASE_URL_UNPOOLED is the direct one (migrations).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/sanjeevani?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/sanjeevani?sslmode=require

# --- MongoDB — current database, still used until the switch-over -----------
MONGODB_URI=mongodb+srv://YOUR_ATLAS_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=Sanjeevani_group_of_companies

# --- Admin accounts (Phase 3) ------------------------------------------------
# Random secret, at least 32 characters, used to hash IPs/emails for rate
# limits and the audit log. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public base URL for links in emails. Required in production; read at runtime.
# SITE_URL=https://www.example.com

# --- Image uploads (Phase 4) ------------------------------------------------
# Cloudinary dashboard -> API Keys. Without these, local development stores
# uploads in public/uploads/ and production refuses uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=sanjeevani

# --- Current shared admin login (replaced by individual accounts in Phase 3) --
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# --- Applications and email (Phase 5) ----------------------------------------
# Resend (resend.com): API key + a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Sanjeevani Group <no-reply@your-verified-domain>"
# Where new-application notifications go (comma-separated).
HR_NOTIFICATION_EMAIL=
# Optional: where website enquiries go (defaults to HR_NOTIFICATION_EMAIL).
# CONTACT_NOTIFICATION_EMAIL=
# Protects /api/cron/maintenance (send queued emails, close expired vacancies).
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
# CV storage: cloudinary (default when Cloudinary is set) or database.
# CV_STORAGE=
# How long applications are kept before HR is prompted to delete them.
# APPLICATION_RETENTION_DAYS=730

